# Dependencies
node_modules

# Build output — committed intentionally.
# Prerendering needs headless Chrome, which the Vercel build image lacks, so
# `npm run build` runs locally and the prerendered dist/ is committed and
# served as-is (buildCommand is disabled in vercel.json).

# Generated content (built from markdown at build time)
public/data
public/sitemap.xml

# Environment
.env.local
.env

# OS / Editor
.DS_Store
*.pem
*.log

# Legacy Next.js (no longer used)
.next
out
